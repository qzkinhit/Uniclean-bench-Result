Uniclean_cleaned_data/original_error_cleaned_data/*_runtime/
Uniclean_cleaned_data/original_error_cleaned_data/*_runtimeCleaned/
Uniclean_cleaned_data/artificial_error_cleaned_data/*_runtime/
Uniclean_cleaned_data/artificial_error_cleaned_data/*_runtimeCleaned/

# Cloud sync metadata (Baidu Netdisk client temp files)
*.baiduyun.uploading.cfg
.baiduyun.uploading.cfg
*.baiduyun.downloading.cfg

